# srsRAN Manager Web/API 服务 —— 仅提供 REST API + WebSocket + 静态前端。
# 通过 SRSRAN_MANAGER_ONLY=1 去掉进程内看门狗（由 srsran-watchdog 承担）,
# 控制命令经共享 SQLite (kv_state) 下发给看门狗进程执行。
#
# 权限说明: Ubuntu 20.04 的 polkit 无法按 unit 粒度授权 manage-units,
# 因此本服务以 root 运行, 用 systemd 加固指令限制其影响面:
#   - ProtectSystem=full    /usr /boot /etc 只读
#   - ProtectHome=true      /home /root /run-user 不可见
#   - NoNewPrivileges       禁止提权
# Web 层不暴露任意 shell: 控制接口只调用固定的 systemctl start/stop/restart。
[Unit]
Description=srsRAN Manager Web UI / API
After=network.target srsran-watchdog.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/srsran-manager/backend
Environment=SRSRAN_CONFIG=/etc/srsran-manager/config.yaml
Environment=SRSRAN_MANAGER_ONLY=1
ExecStart=/opt/srsran-manager/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/srsran-manager/backend/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
